# Copy to .env.local after `supabase start`. Get the local values with `supabase status -o env`.
# API_URL -> NEXT_PUBLIC_SUPABASE_URL
# ANON_KEY -> NEXT_PUBLIC_SUPABASE_ANON_KEY
# SERVICE_ROLE_KEY -> SUPABASE_SERVICE_ROLE_KEY (server only; never expose with NEXT_PUBLIC_)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Local email/password sign-up works without Google OAuth credentials.
# Hosted deployments default to Google unless this is explicitly set to email.
NEXT_PUBLIC_AUTH_MODE=email

# Optional: required only for Drizzle CLI / db/index.ts, not for the normal app flow.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55322/postgres

# Optional: higher Google Books API quota and affiliate links.
GOOGLE_BOOKS_API_KEY=
# The legacy name remains supported, but AMAZON_ASSOCIATES_TAG is preferred.
AMAZON_ASSOCIATES_TAG=
NEXT_PUBLIC_AMAZON_TAG=
AUDIBLE_AFFILIATE_TAG=
